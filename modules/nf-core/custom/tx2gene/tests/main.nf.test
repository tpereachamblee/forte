nextflow_process {

    name "Test Process CUSTOM_TX2GENE"
    script "../main.nf"
    process "CUSTOM_TX2GENE"
    tag "modules"
    tag "modules_nfcore"
    tag "custom"
    tag "tx2gene"
    tag "custom/tx2gene"

    test("Should generate tx2gene mapping from GTF and kallisto quantifications") {
        when {
            process {
                """
                // Create test GTF content (proper 9-column format)
                def gtf_content = '''
#!genome-build GRCh38.p13
1	ensembl	transcript	1	100	.	+	.	gene_id "ENSG00000290825"; transcript_id "ENST00000415118.1"; gene_name "GENE1";
1	ensembl	exon	1	100	.	+	.	gene_id "ENSG00000290825"; transcript_id "ENST00000415118.1"; gene_name "GENE1";
1	ensembl	transcript	200	300	.	+	.	gene_id "ENSG00000223972"; transcript_id "ENST00000448914.1"; gene_name "GENE2";
1	ensembl	exon	200	300	.	+	.	gene_id "ENSG00000223972"; transcript_id "ENST00000448914.1"; gene_name "GENE2";
1	ensembl	transcript	400	500	.	+	.	gene_id "ENSG00000243485"; transcript_id "ENST00000434970.2"; gene_name "GENE3";
1	ensembl	exon	400	500	.	+	.	gene_id "ENSG00000243485"; transcript_id "ENST00000434970.2"; gene_name "GENE3";
                '''.stripIndent()

                // Create test abundance.tsv content
                def abundance_content = '''
target_id	length	eff_length	est_counts	tpm
ENST00000415118.1	100	95	10	5.2
ENST00000448914.1	150	145	20	6.8
ENST00000434970.2	200	195	15	3.8
                '''.stripIndent()

                // Set up test data
                def gtf_file = file("test.gtf")
                gtf_file.text = gtf_content
                
                def quant_dir = file("test_quant")
                quant_dir.mkdirs()
                def abundance_file = file("test_quant/abundance.tsv")
                abundance_file.text = abundance_content

                input[0] = [ [ id: 'test' ], gtf_file ]
                input[1] = [ [ id: 'test_sample' ], quant_dir ]
                input[2] = "kallisto"
                input[3] = "gene_id"
                input[4] = "gene_name"
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}